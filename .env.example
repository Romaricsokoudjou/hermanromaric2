# Base de données PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# URL publique du site (liens de parrainage, sitemap, QR codes)
SITE_URL=https://hermanfashion.com

# Premier super administrateur (créé au premier démarrage si aucun n'existe)
ADMIN_EMAIL=admin@hermanfashion.com
ADMIN_PHONE=+237600000000
ADMIN_PASSWORD=changez-moi-immediatement

# Paiement Chariow : secret de signature du Pulse (whsec_...). SANS ce secret aucune confirmation automatique n'est acceptée.
CHARIOW_WEBHOOK_SECRET=

# Envoi des codes de vérification / notifications (webhook JSON {channel,to,subject,body}, ex. passerelle SMS/e-mail/WhatsApp)
MESSAGING_WEBHOOK_URL=
MESSAGING_WEBHOOK_TOKEN=

# HERMAN AI (API compatible OpenAI). Sans clé : réponses basées sur la base de connaissances.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Mode démonstration : affiche les codes de vérification à l'écran. METTRE 0 (ou supprimer) EN PRODUCTION.
SHOW_DEV_CODES=0
